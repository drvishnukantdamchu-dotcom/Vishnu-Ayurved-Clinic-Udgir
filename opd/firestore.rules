rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function clinician(){return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner','doctor'];}
  function validRecord(d,recordId){
   return d.keys().hasAll(['id','kind','payload','deleted','createdBy','updatedBy','updatedAt'])
    && d.keys().hasOnly(['id','kind','payload','deleted','createdBy','updatedBy','updatedAt'])
    && d.id is string && d.id.matches('VAC-OPD-[A-Za-z0-9_-]{1,140}')
    && d.kind in ['intake','clinical','prescription','panchakarma','followup','review']
    && recordId == d.kind + '_' + d.id
    && d.payload is string && d.payload.size() <= 800000
    && d.deleted is bool && d.createdBy is string
    && d.updatedBy == request.auth.uid && d.updatedAt is string && d.updatedAt.size() <= 40;
  }
  match /clinicRecords/{recordId}{
   allow get,list: if clinician();
   allow create: if clinician() && validRecord(request.resource.data,recordId) && request.resource.data.createdBy == request.auth.uid;
   allow update: if clinician() && validRecord(request.resource.data,recordId) && request.resource.data.createdBy == resource.data.createdBy;
   allow delete: if false;
  }
  match /users/{uid}{allow get: if signedIn() && request.auth.uid==uid; allow list,create,update,delete: if false;}
  match /{document=**}{allow read,write: if false;}
 }
}
