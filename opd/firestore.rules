rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function clinician(){return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner','doctor'];}
  function student(){return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';}
  function ownIntake(d){return student() && d.createdBy == request.auth.uid && d.kind in ['intake','clinical'];}
  function studentWrite(d){return ownIntake(d) && (d.kind == 'intake' || (exists(/databases/$(database)/documents/clinicRecords/$('intake_' + d.id)) && get(/databases/$(database)/documents/clinicRecords/$('intake_' + d.id)).data.createdBy == request.auth.uid));}
  function validRecord(d,recordId){
   return d.keys().hasAll(['id','kind','payload','deleted','createdBy','updatedBy','updatedAt'])
    && d.keys().hasOnly(['id','kind','payload','deleted','createdBy','updatedBy','updatedAt'])
    && d.id is string && d.id.matches('VAC-OPD-[A-Za-z0-9_-]{1,140}')
    && d.kind in ['intake','clinical','prescription','panchakarma','followup','review']
    && recordId == d.kind + '_' + d.id
    && d.payload is string && d.payload.size() <= 800000
    && d.deleted is bool && d.createdBy is string
    && d.updatedBy == request.auth.uid && d.updatedAt is string && d.updatedAt.size() <= 40;
  }
  match /clinicRecords/{recordId}{
   allow get,list: if clinician() || ownIntake(resource.data);
   allow create: if (clinician() || studentWrite(request.resource.data)) && validRecord(request.resource.data,recordId) && request.resource.data.createdBy == request.auth.uid;
   allow update: if (clinician() || (ownIntake(resource.data) && studentWrite(request.resource.data))) && validRecord(request.resource.data,recordId) && request.resource.data.createdBy == resource.data.createdBy;
   allow delete: if false;
  }
  match /users/{uid}{allow get: if signedIn() && request.auth.uid==uid; allow list,delete: if false;
   allow create,update: if clinician() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner' && uid != request.auth.uid
    && request.resource.data.keys().hasAll(['role','active','displayName']) && request.resource.data.keys().hasOnly(['role','active','displayName'])
    && request.resource.data.role == 'student' && request.resource.data.active is bool && request.resource.data.displayName == 'Clinic entry device'
    && (!exists(/databases/$(database)/documents/users/$(uid)) || resource.data.role == 'student');}

  match /{document=**}{allow read,write: if false;}
 }
}
